# Database (SQLite file for local dev; use postgresql://... for production)
# Path is relative to the prisma/ folder (creates prisma/dev.db)
DATABASE_URL="file:./dev.db"

# NextAuth — generate: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-secret"
NEXTAUTH_URL="http://localhost:3000"

# Stripe (Billing → Products: create recurring monthly price, copy Price ID)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_PRICE_ID_PAID="price_..."

# XUI.one Admin API (Management → Access Control → Access Codes → Admin API)
# Base URL including /accesscode path, e.g. https://panel.example.com:9000/accesscode
XUI_BASE_URL="https://your-panel:9000/accesscode"
XUI_API_KEY="your_admin_api_key"
# Comma-separated bouquet IDs for new lines (e.g. 1,2,3)
XUI_BOUQUET_IDS="1"
XUI_MAX_CONNECTIONS="1"
